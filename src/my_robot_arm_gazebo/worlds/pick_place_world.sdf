<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="pick_place_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></visual>
    </link></model>

    <!-- Main work table: top surface is z=0.425. -->
    <model name="table"><static>true</static><pose>0.5 0 0.4 0 0 0</pose><link name="table_link">
      <collision name="table_collision"><geometry><box><size>0.8 0.8 0.05</size></box></geometry></collision>
      <visual name="table_visual"><geometry><box><size>0.8 0.8 0.05</size></box></geometry><material><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
    </link></model>

    <!-- Five dedicated static placement pads. They are physical support surfaces, not teleport targets. -->
    <model name="place_pad_box_small"><static>true</static><pose>0.34 0.18 0.428 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.11 0.11 0.006</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.11 0.11 0.006</size></box></geometry><material><diffuse>0.9 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="place_pad_box_medium"><static>true</static><pose>0.50 0.18 0.428 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.12 0.11 0.006</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 0.11 0.006</size></box></geometry><material><diffuse>0.2 0.4 0.9 1</diffuse></material></visual></link></model>
    <model name="place_pad_box_large"><static>true</static><pose>0.26 0.30 0.428 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.13 0.12 0.006</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.13 0.12 0.006</size></box></geometry><material><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link></model>
    <model name="place_pad_cylinder_small"><static>true</static><pose>0.22 0.17 0.428 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.06</radius><length>0.006</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.06</radius><length>0.006</length></cylinder></geometry><material><diffuse>0.8 0.2 0.8 1</diffuse></material></visual></link></model>
    <model name="place_pad_cylinder_large"><static>true</static><pose>0.42 0.32 0.428 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.006</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.05</radius><length>0.006</length></cylinder></geometry><material><diffuse>0.1 0.8 0.8 1</diffuse></material></visual></link></model>

    <!-- Dynamic grasp objects; high friction supports physical two-finger grasps. -->
    <model name="box_small"><pose>0.38 -0.22 0.445 0 0 0</pose><link name="object_link"><inertial><mass>0.060</mass><inertia><ixx>0.000014</ixx><iyy>0.000011</iyy><izz>0.000009</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.035 0.045 0.040</size></box></geometry><surface><friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction><contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact></surface></collision><visual name="visual"><geometry><box><size>0.035 0.045 0.040</size></box></geometry><material><diffuse>0.9 0.15 0.15 1</diffuse></material></visual></link></model>
    <model name="box_medium"><pose>0.50 -0.16 0.450 0 0 0</pose><link name="object_link"><inertial><mass>0.090</mass><inertia><ixx>0.000025</ixx><iyy>0.000029</iyy><izz>0.000030</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.055 0.040 0.050</size></box></geometry><surface><friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>0.055 0.040 0.050</size></box></geometry><material><diffuse>0.15 0.3 0.9 1</diffuse></material></visual></link></model>
    <model name="box_large"><pose>0.48 -0.28 0.455 0 0 0</pose><link name="object_link"><inertial><mass>0.120</mass><inertia><ixx>0.000050</ixx><iyy>0.000064</iyy><izz>0.000057</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.070 0.045 0.060</size></box></geometry><surface><friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>0.070 0.045 0.060</size></box></geometry><material><diffuse>0.95 0.65 0.1 1</diffuse></material></visual></link></model>
    <model name="cylinder_small"><pose>0.42 0.03 0.450 0 0 0</pose><link name="object_link"><inertial><mass>0.065</mass><inertia><ixx>0.000017</ixx><iyy>0.000017</iyy><izz>0.000016</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.022</radius><length>0.050</length></cylinder></geometry><surface><friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.022</radius><length>0.050</length></cylinder></geometry><material><diffuse>0.75 0.15 0.75 1</diffuse></material></visual></link></model>
    <model name="cylinder_large"><pose>0.52 0.03 0.455 0 0 0</pose><link name="object_link"><inertial><mass>0.100</mass><inertia><ixx>0.000036</ixx><iyy>0.000036</iyy><izz>0.000051</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.032</radius><length>0.060</length></cylinder></geometry><surface><friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.032</radius><length>0.060</length></cylinder></geometry><material><diffuse>0.1 0.75 0.75 1</diffuse></material></visual></link></model>
  </world>
</sdf>
